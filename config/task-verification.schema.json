{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "W verification contract v1",
  "oneOf": [
    {
      "$ref": "#/$defs/repositoryManifest"
    },
    {
      "$ref": "#/$defs/workspaceRegistry"
    }
  ],
  "$defs": {
    "identifier": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$"
    },
    "repositoryName": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$"
    },
    "fullCommitSha": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "safeRelativePath": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!/)(?!.*[\\u0000-\\u001f\\u007f-\\u009f\\u2028\\u2029])(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*//)(?!.*\\/$)(?!.*\\\\).+$"
    },
    "workspaceRelativePath": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!/)(?!.*[\\u0000-\\u001f\\u007f-\\u009f\\u2028\\u2029])(?!.*//)(?!.*\\/$)(?!.*\\\\).+$"
    },
    "repositoryFilePath": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!/)(?!\\.project/task-runs(?:/|$))(?!.*[\\u0000-\\u001f\\u007f-\\u009f\\u2028\\u2029])(?!.*(?:^|/)(?:\\.|\\.\\.)(?:/|$))(?!.*//)(?!.*\\/$)(?!.*\\\\).+$"
    },
    "positiveGlob": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?![!/])(?!.*[\\u0000-\\u001f\\u007f-\\u009f\\u2028\\u2029])(?!.*\\\\)(?!.*//)(?!.*\\/$)(?!.*(?:^|/)(?:\\.|\\.\\.)(?:/|$))(?!.*[{}\\[\\]])(?!.*[?*+@!]\\().+$"
    },
    "profile": {
      "enum": [
        "affected",
        "testing",
        "pr",
        "release"
      ]
    },
    "repositoryStatus": {
      "enum": [
        "active",
        "reserved",
        "historical",
        "unmanaged"
      ]
    },
    "automaticAction": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "argv",
        "cwd"
      ],
      "properties": {
        "kind": {
          "const": "automatic"
        },
        "argv": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          }
        },
        "cwd": {
          "$ref": "#/$defs/safeRelativePath"
        }
      }
    },
    "obligationAction": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "obligationType",
        "reason"
      ],
      "properties": {
        "kind": {
          "const": "obligation"
        },
        "obligationType": {
          "enum": [
            "manual",
            "external",
            "stateful"
          ]
        },
        "reason": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "action": {
      "oneOf": [
        {
          "$ref": "#/$defs/automaticAction"
        },
        {
          "$ref": "#/$defs/obligationAction"
        }
      ]
    },
    "coverage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "affected",
        "testing",
        "pr",
        "release"
      ],
      "properties": {
        "affected": {
          "$ref": "#/$defs/actionReferences"
        },
        "testing": {
          "$ref": "#/$defs/actionReferences"
        },
        "pr": {
          "$ref": "#/$defs/actionReferences"
        },
        "release": {
          "$ref": "#/$defs/actionReferences"
        }
      }
    },
    "actionReferences": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/identifier"
      }
    },
    "nonEmptyActionReferences": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/identifier"
      }
    },
    "area": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "paths",
        "dependsOn",
        "coverage"
      ],
      "properties": {
        "paths": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/positiveGlob"
          }
        },
        "dependsOn": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/identifier"
          }
        },
        "coverage": {
          "$ref": "#/$defs/coverage"
        }
      }
    },
    "boundary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "actions"
      ],
      "properties": {
        "actions": {
          "$ref": "#/$defs/nonEmptyActionReferences"
        }
      }
    },
    "artifactSurface": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "paths"
      ],
      "properties": {
        "paths": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/positiveGlob"
          }
        }
      }
    },
    "repositoryManifest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schemaVersion",
        "kind",
        "repository",
        "status",
        "policy",
        "actions",
        "areas",
        "boundaries",
        "metaGate",
        "inputs",
        "exports"
      ],
      "properties": {
        "$schema": {
          "type": "string",
          "minLength": 1
        },
        "schemaVersion": {
          "const": 1
        },
        "kind": {
          "const": "repository"
        },
        "repository": {
          "$ref": "#/$defs/repositoryName"
        },
        "status": {
          "$ref": "#/$defs/repositoryStatus"
        },
        "policy": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "fallbackBoundary"
          ],
          "properties": {
            "fallbackBoundary": {
              "$ref": "#/$defs/identifier"
            }
          }
        },
        "actions": {
          "type": "object",
          "minProperties": 1,
          "propertyNames": {
            "$ref": "#/$defs/identifier"
          },
          "additionalProperties": {
            "$ref": "#/$defs/action"
          }
        },
        "areas": {
          "type": "object",
          "minProperties": 1,
          "propertyNames": {
            "$ref": "#/$defs/identifier"
          },
          "additionalProperties": {
            "$ref": "#/$defs/area"
          }
        },
        "boundaries": {
          "type": "object",
          "minProperties": 1,
          "propertyNames": {
            "$ref": "#/$defs/identifier"
          },
          "additionalProperties": {
            "$ref": "#/$defs/boundary"
          }
        },
        "metaGate": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "actions",
            "profiles"
          ],
          "properties": {
            "actions": {
              "$ref": "#/$defs/actionReferences"
            },
            "profiles": {
              "type": "array",
              "uniqueItems": true,
              "items": {
                "$ref": "#/$defs/profile"
              }
            }
          }
        },
        "inputs": {
          "type": "object",
          "propertyNames": {
            "$ref": "#/$defs/identifier"
          },
          "additionalProperties": {
            "$ref": "#/$defs/artifactSurface"
          }
        },
        "exports": {
          "type": "object",
          "propertyNames": {
            "$ref": "#/$defs/identifier"
          },
          "additionalProperties": {
            "$ref": "#/$defs/artifactSurface"
          }
        }
      }
    },
    "repositoryRegistration": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "enrollment",
        "root"
      ],
      "properties": {
        "status": {
          "$ref": "#/$defs/repositoryStatus"
        },
        "enrollment": {
          "enum": [
            "enrolled",
            "pending"
          ]
        },
        "root": {
          "$ref": "#/$defs/workspaceRelativePath"
        },
        "manifest": {
          "$ref": "#/$defs/repositoryFilePath"
        },
        "revision": {
          "$ref": "#/$defs/fullCommitSha"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "enrollment": {
                "const": "enrolled"
              }
            },
            "required": [
              "enrollment"
            ]
          },
          "then": {
            "properties": {
              "manifest": {
                "$ref": "#/$defs/repositoryFilePath"
              }
            },
            "required": [
              "manifest"
            ]
          },
          "else": {
            "not": {
              "anyOf": [
                {
                  "properties": {
                    "manifest": true
                  },
                  "required": [
                    "manifest"
                  ]
                },
                {
                  "properties": {
                    "revision": true
                  },
                  "required": [
                    "revision"
                  ]
                }
              ]
            }
          }
        },
        {
          "if": {
            "properties": {
              "status": {
                "not": {
                  "const": "active"
                }
              }
            },
            "required": [
              "status"
            ]
          },
          "then": {
            "properties": {
              "enrollment": {
                "const": "pending"
              }
            }
          }
        }
      ]
    },
    "producer": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "repository",
            "export"
          ],
          "properties": {
            "repository": {
              "$ref": "#/$defs/repositoryName"
            },
            "export": {
              "$ref": "#/$defs/identifier"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "repository",
            "path"
          ],
          "properties": {
            "repository": {
              "$ref": "#/$defs/repositoryName"
            },
            "path": {
              "$ref": "#/$defs/positiveGlob"
            }
          }
        }
      ]
    },
    "consumer": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "repository",
        "input"
      ],
      "properties": {
        "repository": {
          "$ref": "#/$defs/repositoryName"
        },
        "input": {
          "$ref": "#/$defs/identifier"
        }
      }
    },
    "actionVerifier": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "repository",
        "action"
      ],
      "properties": {
        "kind": {
          "const": "action"
        },
        "repository": {
          "$ref": "#/$defs/repositoryName"
        },
        "action": {
          "$ref": "#/$defs/identifier"
        }
      }
    },
    "obligationVerifier": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "obligationType",
        "reason"
      ],
      "properties": {
        "kind": {
          "const": "obligation"
        },
        "obligationType": {
          "enum": [
            "manual",
            "external",
            "stateful"
          ]
        },
        "reason": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "relation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "producer",
        "consumer",
        "type",
        "verifier"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/identifier"
        },
        "producer": {
          "$ref": "#/$defs/producer"
        },
        "consumer": {
          "$ref": "#/$defs/consumer"
        },
        "type": {
          "enum": [
            "exact-copy",
            "generated",
            "compatibility",
            "artifact"
          ]
        },
        "verifier": {
          "oneOf": [
            {
              "$ref": "#/$defs/actionVerifier"
            },
            {
              "$ref": "#/$defs/obligationVerifier"
            }
          ]
        }
      }
    },
    "exceptionScope": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "repository",
        "path"
      ],
      "properties": {
        "repository": {
          "$ref": "#/$defs/repositoryName"
        },
        "path": {
          "$ref": "#/$defs/positiveGlob"
        }
      }
    },
    "exception": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "version",
        "scope",
        "owner",
        "reason",
        "expiresAt"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/identifier"
        },
        "version": {
          "type": "integer",
          "minimum": 1
        },
        "scope": {
          "$ref": "#/$defs/exceptionScope"
        },
        "owner": {
          "type": "string",
          "minLength": 1
        },
        "reason": {
          "type": "string",
          "minLength": 1
        },
        "expiresAt": {
          "type": "string",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
        }
      }
    },
    "workspaceRegistry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schemaVersion",
        "kind",
        "ownerRepository",
        "repositories",
        "relations",
        "exceptions"
      ],
      "properties": {
        "$schema": {
          "type": "string",
          "minLength": 1
        },
        "schemaVersion": {
          "const": 1
        },
        "kind": {
          "const": "workspace"
        },
        "ownerRepository": {
          "$ref": "#/$defs/repositoryName"
        },
        "repositories": {
          "type": "object",
          "minProperties": 1,
          "propertyNames": {
            "$ref": "#/$defs/repositoryName"
          },
          "additionalProperties": {
            "$ref": "#/$defs/repositoryRegistration"
          }
        },
        "relations": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/relation"
          }
        },
        "exceptions": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/exception"
          }
        }
      }
    }
  }
}
