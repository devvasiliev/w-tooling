{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://task.local/schemas/business-value-research-brief.schema.json",
  "title": "Business Value research brief",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "changeCategory", "generalizedProblem", "audienceCategory", "metricIds", "queries"],
  "properties": {
    "schemaVersion": { "type": "integer", "const": 1 },
    "changeCategory": {
      "type": "string",
      "enum": ["acquisition", "activation", "retention", "engagement", "monetization", "quality", "satisfaction", "efficiency", "market"]
    },
    "generalizedProblem": { "type": "string", "minLength": 10, "maxLength": 500 },
    "audienceCategory": { "type": "string", "minLength": 3, "maxLength": 120 },
    "metricIds": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/definitions/metricId" }
    },
    "queries": {
      "type": "array",
      "maxItems": 6,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "problemClass", "audienceCategory", "metricIds", "keywords"],
        "properties": {
          "id": { "type": "string", "pattern": "^query-[1-9][0-9]*$" },
          "problemClass": { "type": "string", "minLength": 3, "maxLength": 160 },
          "audienceCategory": { "type": "string", "minLength": 3, "maxLength": 120 },
          "metricIds": {
            "type": "array",
            "minItems": 1,
            "items": { "$ref": "#/definitions/metricId" }
          },
          "keywords": {
            "type": "array",
            "minItems": 2,
            "maxItems": 12,
            "items": { "type": "string", "minLength": 2, "maxLength": 60 }
          }
        }
      }
    }
  },
  "definitions": {
    "metricId": {
      "type": "string",
      "enum": [
        "leads_monthly",
        "registrations_monthly",
        "registration_conversion",
        "cost_per_lead",
        "target_audience",
        "target_spend_capacity",
        "registration_dropoff",
        "d30_retention",
        "mau",
        "wau",
        "dau",
        "engagement_minutes",
        "paying_users",
        "arppu",
        "gross_revenue_monthly",
        "csi",
        "complaints_monthly",
        "infrastructure_cost_monthly"
      ]
    }
  }
}
